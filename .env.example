# ================================================================
# CropGuard AI — Environment Configuration
# Smart India Hackathon (SIH 2026)
# ================================================================

# --- Backend Core Settings ---
# Used for JWT authentication and cryptographic signing. (Min 32 characters recommended in production)
SECRET_KEY=replace_with_secure_random_secret_min_32_characters

# --- Database Connection ---
# Local Development: SQLite (auto-created)
DATABASE_URL=sqlite:///./cropguard.db
# Cloud / Production (Neon, Supabase, Render, Railway, AWS RDS PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Machine Learning Model Settings ---
MODEL_VERSION=v1.0.0-MobileNetV3
# Inference Device: 'cpu' (default for Vercel/cloud) or 'cuda' (if dedicated GPU host is available)
DEVICE=cpu

# --- CORS Settings (Backend) ---
# Comma-separated list of allowed frontend origins in production
# e.g., https://cropguard-ai.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Settings ---
# API Base URL:
# - Leave empty if frontend & API are deployed together on Vercel (same-origin /api requests)
# - Set to your deployed backend URL if running a separate backend (e.g. https://cropguard-api.onrender.com)
VITE_API_URL=
