# ================================================================
# CropGuard AI — Environment Configuration Template
# Smart India Hackathon (SIH 2026)
# ================================================================

# ================================================================
# [SERVER-SIDE ONLY] — Backend / Vercel Serverless Function
# CRITICAL: NEVER expose these with a VITE_ prefix to the client
# ================================================================

# JWT Secret for password hashing and authentication tokens
# Production: Set to a strong random 32+ character string
SECRET_KEY=

# Database Connection String
# Local fallback: sqlite:///./cropguard.db
# Cloud Production (Neon / Supabase / Railway): postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Machine Learning Engine Configuration
MODEL_VERSION=v1.0.0-MobileNetV3
DEVICE=cpu

# Allowed Frontend Origins (Comma-separated for production CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://cropguard-ai.vercel.app

# ================================================================
# [CLIENT-SIDE ONLY] — Vite Browser Bundle
# Note: Only variables prefixed with VITE_ are exposed to the browser
# ================================================================

# Backend API Base URL
# - For full-stack deployment on Vercel: leave empty (defaults to relative /api)
# - For separated backend (Render/Railway): set to deployed backend URL (e.g. https://cropguard-backend.onrender.com)
VITE_API_URL=

